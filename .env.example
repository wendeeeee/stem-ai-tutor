NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://localhost:5173
VITE_API_ORIGIN=
DATABASE_URL=postgresql://stem_tutor:stem_tutor@localhost:5432/stem_tutor
DATABASE_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_PREFIX=stem-ai-tutor
ADMIN_INGESTION_KEY=replace-with-a-long-random-value
CORPUS_UPLOAD_DIR=var/corpus-uploads
CORPUS_MAX_FILE_SIZE_BYTES=20971520
CHUNK_MAX_CHARACTERS=2400
CHUNK_OVERLAP_CHARACTERS=300
OPENAI_API_KEY=
GEMINI_API_Key=
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSLATION_TIMEOUT_MS=30000
GEMINI_TRANSLATION_MAX_OUTPUT_TOKENS=4000
# Keep these at 0 unless you have verified current Gemini pricing.
GEMINI_TRANSLATION_INPUT_COST_PER_MILLION_TOKENS_USD=0
GEMINI_TRANSLATION_OUTPUT_COST_PER_MILLION_TOKENS_USD=0
VOICE_MAX_AUDIO_BYTES=8388608
VOICE_MAX_RECORDING_SECONDS=30
ASR_MODEL=gpt-4o-mini-transcribe-2025-12-15
ASR_DEFAULT_LANGUAGE=en
ASR_TIMEOUT_MS=20000
ASR_REQUESTS_PER_MINUTE=10
ASR_COST_PER_MINUTE_USD=0.003
TTS_PROVIDER=naijalingo
NAIJALINGO_API_KEY=
NAIJALINGO_API_URL=https://api.9jalingo.org
NAIJALINGO_MODEL=9jalingo-tts-1
NAIJALINGO_VOICE_PCM=ada_pcm
NAIJALINGO_VOICE_IG=adaeze_ig
NAIJALINGO_VOICE_YO=adeola_yo
NAIJALINGO_VOICE_HA=aisha_ha
NAIJALINGO_MAX_INPUT_CHARACTERS=8000
NAIJALINGO_TIMEOUT_MS=120000
NAIJALINGO_MAX_AUDIO_RESPONSE_BYTES=20971520
NAIJALINGO_PRICING_VERSION=unconfigured
NAIJALINGO_PRICING_CURRENCY=NGN
NAIJALINGO_PRICING_EFFECTIVE_DATE=
NAIJALINGO_COST_PER_1000_CHARACTERS=
# Long 9jaLingo lessons are normalized and split into sequential WAV chunks.
TTS_CHUNK_MIN_CHARACTERS=400
TTS_CHUNK_PREFERRED_CHARACTERS=550
TTS_CHUNK_MAX_CHARACTERS=700
TTS_CHUNK_MAX_RETRIES=2
TTS_CHUNK_RETRY_BASE_DELAY_MS=500
# Per provider attempt. Keep this bounded even if the provider ignores abort.
TTS_APPLICATION_TIMEOUT_MS=300000
# Successful partial chunks are resumable only within the current API process.
TTS_CHUNK_CACHE_TTL_MS=900000
TTS_CHUNK_CACHE_MAX_BYTES=67108864
TTS_MAX_TOTAL_AUDIO_BYTES=25165824
# ElevenLabs is retained as an explicit TTS_PROVIDER=elevenlabs alternative.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_API_URL=https://api.elevenlabs.io/v1
ELEVEN_LABS_VOICE_ID=
ELEVEN_LABS_VOICE_NAME=
ELEVEN_LABS_MODEL_ID=eleven_flash_v2_5
ELEVEN_LABS_OUTPUT_FORMAT=mp3_44100_128
ELEVEN_LABS_LANGUAGE_CODE=en
ELEVEN_LABS_MAX_INPUT_CHARACTERS=40000
ELEVEN_LABS_TIMEOUT_MS=120000
ELEVEN_LABS_MAX_AUDIO_RESPONSE_BYTES=20971520
ELEVEN_LABS_ENABLE_LOGGING=true
ELEVEN_LABS_PRICING_VERSION=api-pricing-2026-07-24
ELEVEN_LABS_PRICING_CURRENCY=USD
ELEVEN_LABS_PRICING_EFFECTIVE_DATE=2026-07-24
ELEVEN_LABS_COST_PER_1000_CHARACTERS=0.05
# YarnGPT is retained as an explicit TTS_PROVIDER=yarngpt alternative.
YARN_GPT_API_KEY=
YARN_GPT_API_URL=https://yarngpt.ai/api/v1/tts
YARN_GPT_VOICE=Chinenye
YARN_GPT_RESPONSE_FORMAT=mp3
YARN_GPT_MAX_INPUT_CHARACTERS=2000
YARN_GPT_TIMEOUT_MS=30000
YARN_GPT_MAX_AUDIO_RESPONSE_BYTES=10485760
YARN_GPT_PRICING_VERSION=unconfigured-2026-07-24
YARN_GPT_PRICING_CURRENCY=NGN
YARN_GPT_PRICING_EFFECTIVE_DATE=
YARN_GPT_COST_PER_1000_CHARACTERS=
# OpenAI TTS is retained as an explicit TTS_PROVIDER=openai alternative.
TTS_MODEL=gpt-4o-mini-tts-2025-12-15
TTS_VOICE=cedar
TTS_FORMAT=mp3
TTS_TIMEOUT_MS=20000
TTS_REQUESTS_PER_MINUTE=10
TTS_MAX_INPUT_CHARACTERS=4096
TTS_ESTIMATED_CHARACTERS_PER_SECOND=14
TTS_COST_PER_MINUTE_USD=0.015
VOICE_PRICING_VERSION=2026-07-23
SSE_HEARTBEAT_INTERVAL_MS=15000
QUERY_TRANSFORMER_MODEL=gpt-5.6-luna
QUERY_TRANSFORMER_MAX_OUTPUT_TOKENS=300
QUERY_TRANSFORMER_INPUT_COST_PER_MILLION_TOKENS_USD=1.00
QUERY_TRANSFORMER_OUTPUT_COST_PER_MILLION_TOKENS_USD=6.00
TUTOR_MODEL=gpt-5.6-terra
TUTOR_MAX_OUTPUT_TOKENS=1200
TUTOR_INPUT_COST_PER_MILLION_TOKENS_USD=2.50
TUTOR_OUTPUT_COST_PER_MILLION_TOKENS_USD=15.00
GROUNDING_VERIFIER_MODEL=gpt-5.6-terra
GROUNDING_VERIFIER_MAX_OUTPUT_TOKENS=1000
GROUNDING_VERIFIER_INPUT_COST_PER_MILLION_TOKENS_USD=2.50
GROUNDING_VERIFIER_OUTPUT_COST_PER_MILLION_TOKENS_USD=15.00
REINFORCEMENT_MODEL=gpt-5.6-terra
REINFORCEMENT_MAX_OUTPUT_TOKENS=1600
REINFORCEMENT_INPUT_COST_PER_MILLION_TOKENS_USD=2.50
REINFORCEMENT_OUTPUT_COST_PER_MILLION_TOKENS_USD=15.00
REINFORCEMENT_EVALUATOR_MODEL=gpt-5.6-terra
REINFORCEMENT_EVALUATOR_MAX_OUTPUT_TOKENS=300
REINFORCEMENT_EVALUATOR_INPUT_COST_PER_MILLION_TOKENS_USD=2.50
REINFORCEMENT_EVALUATOR_OUTPUT_COST_PER_MILLION_TOKENS_USD=15.00
REINFORCEMENT_QUESTION_COUNT=3
REINFORCEMENT_GENERATION_ATTEMPTS=2
REINFORCEMENT_MAX_ATTEMPTS_PER_QUESTION=3
REINFORCEMENT_TIMEOUT_MS=30000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=50
TUTOR_EMBEDDING_COST_PER_MILLION_TOKENS_USD=0.02
TUTOR_AGENT_TIMEOUT_MS=10000
TUTOR_TOOL_TIMEOUT_MS=10000
TUTOR_MAX_AGENT_CALLS=6
TUTOR_MAX_AGENT_RETRIES=1
TUTOR_MAX_TOOL_RETRIES=1
TUTOR_MAX_TOKENS=32000
TUTOR_MAX_ESTIMATED_COST_USD=0.10
TUTOR_RETRIEVAL_LIMIT=5
TUTOR_RETRIEVAL_THRESHOLD=0.65
